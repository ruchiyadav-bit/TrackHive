# Copy this to .env and fill in real values
# NEVER commit actual .env file

PORT=3050
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/kap-offer-tracker

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=generate-64-char-random-string-here
JWT_EXPIRES_IN=24h

# Admin Seed
ADMIN_EMAIL=admin@kapdigital.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Kushal

# Postback Security
POSTBACK_SECRET=generate-32-char-random-token

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend URL
CLIENT_URL=http://localhost:5173

# Public routing / System Health (production)
DNS_TARGET_CNAME=trackgrowth.ilaunchigo.com
SERVER_IP=5.161.98.12
MONITOR_TRACKING_URL=https://growth.trackyoudomain.com/api/health
MONITOR_DASHBOARD_URL=https://trackgrowth.ilaunchigo.com/api/health
